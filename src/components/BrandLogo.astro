---
type Variant = 'icon' | 'compact' | 'full';
interface Props { variant?: Variant; href?: string; class?: string; eager?: boolean; }
const { variant = 'compact', href = '#inicio', class: className = '', eager = false } = Astro.props;
const assets = {
  icon: '/branding/grupo-norte-isotipo.png',
  compact: '/branding/grupo-norte-compacto.png',
  full: '/branding/grupo-norte-completo.png',
};
const sizes = { icon: 'h-full w-full', compact: 'h-full w-full', full: 'h-full w-full' };
const dimensions = {
  icon: { width: 894, height: 920 },
  compact: { width: 1132, height: 742 },
  full: { width: 1164, height: 806 },
};
const alt = {
  icon: 'Isotipo GN de Grupo Norte',
  compact: 'Grupo Norte',
  full: 'Grupo Norte, Servicios Contables e Impositivos',
};
const label = variant === 'icon' ? 'Grupo Norte, volver al inicio' : 'Grupo Norte, volver al inicio';
---
<a href={href} class={`inline-flex shrink-0 items-center no-underline ${className}`} aria-label={label}>
  <img src={assets[variant]} alt={alt[variant]} width={dimensions[variant].width} height={dimensions[variant].height} class={`${sizes[variant]} object-contain`} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
</a>
