<form id="contact-form" class="grid gap-5" novalidate><div><label for="name" class="mb-2 block text-xs font-semibold uppercase tracking-[.12em] text-[var(--color-text-muted)]">Tu nombre</label><input id="name" name="name" type="text" class="w-full border-b border-[var(--color-border)] bg-transparent px-0 py-3 text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none" placeholder="¿Cómo te llamás?" /></div><div><label for="message" class="mb-2 block text-xs font-semibold uppercase tracking-[.12em] text-[var(--color-text-muted)]">¿En qué podemos ayudarte?</label><textarea id="message" name="message" rows="3" class="w-full resize-none border-b border-[var(--color-border)] bg-transparent px-0 py-3 text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none" placeholder="Contanos brevemente tu consulta"></textarea></div><button type="submit" class="mt-2 w-fit border border-[var(--color-accent)] px-6 py-3 text-xs font-bold uppercase tracking-[.14em] text-[var(--color-secondary)] transition hover:bg-[var(--color-accent)] hover:text-white">Mostrar demo <span aria-hidden="true">↗</span></button><p id="form-note" class="min-h-5 text-sm text-[var(--color-secondary)]" role="status"></p></form><script>document.querySelector('#contact-form')?.addEventListener('submit',e=>{e.preventDefault();const n=document.querySelector('#form-note');if(n)n.textContent='Demo comercial: el formulario está listo para conectar cuando se confirmen los datos de contacto.'});</script>
