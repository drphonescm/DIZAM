---
import '../styles/global.css';
const { title = 'Grupo Norte | Servicios Contables e Impositivos', description = 'Asesoramiento contable e impositivo para personas, profesionales, emprendedores y empresas. Conocé los servicios de Grupo Norte.' } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon/grupo-norte-favicon.png" />
    <link rel="preload" as="image" href="/images/hero-accounting.jpg" fetchpriority="high" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grupo Norte" />
    <title>{title}</title>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-loading');
      }
    </script>
  </head>
  <body>
    <div id="site-loader" aria-hidden="true">
      <img src="/branding/grupo-norte-completo.png" alt="" width="1254" height="1254" fetchpriority="high" decoding="async" />
    </div>
    <slot />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (!root.classList.contains('is-loading')) return;
        const started = performance.now();
        let finished = false;
        const finish = () => {
          if (finished) return;
          finished = true;
          const delay = Math.max(0, 900 - (performance.now() - started));
          window.setTimeout(() => {
            root.classList.remove('is-loading');
            root.classList.add('is-loaded');
          }, delay);
        };
        if (document.readyState === 'complete') finish();
        else window.addEventListener('load', finish, { once: true });
        window.setTimeout(finish, 5000);
      })();
    </script>
  </body>
</html>
